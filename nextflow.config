manifest {
    name            = 'pangenome-variant-bench'
    author          = 'Apostolos Fysekidis'
    description     = 'Stratified comparison of linear and pangenome-aware variant calling'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
    mainScript      = 'main.nf'
}

// Resumability is not a nicety here: the calling step is long enough that a failed run
// without -resume costs an evening.
resume = true

profiles {

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    conda {
        conda.enabled = true
    }

    // Caps that keep a chr20 run inside a laptop. The whole point of scoping to one
    // chromosome is that this profile is the default way to reproduce the result.
    laptop {
        process {
            cpus   = 4
            memory = 8.GB
            time   = 4.h
        }
    }

    test {
        params.sample = 'HG002'
        params.region = 'chr20:1000000-2000000'
    }
}

process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries    = 2
}

report  { enabled = true; file = "${params.outdir}/nextflow_report.html"  }
timeline { enabled = true; file = "${params.outdir}/nextflow_timeline.html" }
trace   { enabled = true; file = "${params.outdir}/nextflow_trace.txt"    }
